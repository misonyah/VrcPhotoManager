<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Works around a dotnet-build/_wpftmp intermediate-project CS0579 duplicate-attribute
         collision on this SDK; this app doesn't need custom assembly metadata anyway. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Project metadata only (GenerateAssemblyInfo=false above means this does NOT get
         embedded into the built exe's file properties) - single source of truth for what
         release a given commit/tag corresponds to. See CHANGELOG.md. -->
    <Version>1.1.0</Version>
    <!-- Velopack needs a custom Main() (App.xaml.cs) that calls VelopackApp.Build().Run()
         before anything else, so the SDK's own auto-generated WPF entry point (normally
         produced from App.xaml's ApplicationDefinition build action) has to be turned off.
         EnableDefaultApplicationDefinition=false is the actual SDK-level switch for this - it
         stops Microsoft.NET.Sdk.WindowsDesktop's default-item globbing from classifying
         App.xaml as ApplicationDefinition in the first place, so it now falls through to the
         SDK's normal default-Page-item globbing instead (no separate ItemGroup override
         needed - an explicit `<Page Include="App.xaml" />` here would just collide with that
         default inclusion, NETSDK1022). A previous attempt reclassified App.xaml via
         `<ApplicationDefinition Remove="App.xaml" /><Page Include="App.xaml" />` instead - that
         depends on evaluation-order luck between the SDK's own default-item injection and this
         project's explicit items, and silently held for most of a session's incremental builds
         before failing with CS0017 ("more than one entry point") on the first fully clean
         build once the MSBuild build-server was restarted, exposing the race. This property is
         the deterministic fix. -->
    <StartupObject>VrcPhotoManager.App</StartupObject>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.4" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

</Project>
