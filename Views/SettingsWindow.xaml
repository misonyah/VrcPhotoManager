<Window x:Class="VrcPhotoManager.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="900" SizeToContent="Height"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="580" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0">
        <TextBlock Text="WD14 Nudity Classifier Model" FontSize="16" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,12">
            Used by "Classify Photos". Model: SmilingWolf/wd-vit-tagger-v3 (Hugging Face).
        </TextBlock>

        <TextBlock Text="Model folder (model.onnx + selected_tags.csv):" Margin="0,0,0,4" />
        <DockPanel Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="Browse..." Padding="8,2" Margin="8,0,0,0" Click="BrowseModelDir_Click" />
            <TextBox x:Name="ModelDirTextBox" VerticalContentAlignment="Center" />
        </DockPanel>

        <Button x:Name="DownloadButton" Content="Download Model Files" HorizontalAlignment="Left"
                Padding="8,4" Margin="0,0,0,8" Click="DownloadModel_Click"
                ToolTip="Download the WD14 model (~378 MB) and tag list into the folder above." />
        <TextBlock x:Name="DownloadStatusText" TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,12" MinHeight="16" />

        <TextBlock Text="CLIP Face-Matching Model" FontSize="16" FontWeight="Bold" Margin="0,12,0,4" />
        <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,12">
            Used by "Suggest Faces". Model: laion/CLIP-ViT-L-14-laion2B-s32B-b82K (Hugging Face,
            ~1.2 GB, image encoder only).
        </TextBlock>

        <TextBlock Text="Model folder (model.onnx):" Margin="0,0,0,4" />
        <DockPanel Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="Browse..." Padding="8,2" Margin="8,0,0,0" Click="BrowseClipModelDir_Click" />
            <TextBox x:Name="ClipModelDirTextBox" VerticalContentAlignment="Center" />
        </DockPanel>

        <Button x:Name="DownloadClipButton" Content="Download CLIP Model Files" HorizontalAlignment="Left"
                Padding="8,4" Margin="0,0,0,8" Click="DownloadClipModel_Click"
                ToolTip="Download the CLIP model (~1.2 GB) into the folder above." />
        <TextBlock x:Name="DownloadClipStatusText" TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,12" MinHeight="16" />

        <TextBlock Text="Avatar Type Classifier" FontSize="16" FontWeight="Bold" Margin="0,12,0,4" />
        <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,12">
            Used by "Classify Avatars". Model: misonyah/vrc-avatar-classifier (Hugging Face).
        </TextBlock>

        <TextBlock Text="Model folder (model.onnx + labels.txt):" Margin="0,0,0,4" />
        <DockPanel Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="Browse..." Padding="8,2" Margin="8,0,0,0" Click="BrowseAvatarModelDir_Click" />
            <TextBox x:Name="AvatarModelDirTextBox" VerticalContentAlignment="Center" />
        </DockPanel>

        <Button x:Name="DownloadAvatarButton" Content="Download Avatar Model Files" HorizontalAlignment="Left"
                Padding="8,4" Margin="0,0,0,8" Click="DownloadAvatarModel_Click"
                ToolTip="Downloads model.onnx and labels.txt into the folder above." />
        <TextBlock x:Name="DownloadAvatarStatusText" TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,12" MinHeight="16" />

        <TextBlock Text="General" FontSize="16" FontWeight="Bold" Margin="0,12,0,4" />
        <CheckBox x:Name="AutoCopyUrlCheckBox" Content="Automatically copy VRCDN URL to clipboard when hovering a photo"
                  Margin="0,0,0,12"
                  ToolTip="Automatically copy the photo's VRCDN URL to your clipboard whenever you hover over it.&#10;Clears the clipboard instead if the photo isn't uploaded yet." />

        <TextBlock Text="Preview pop-up delay:" Margin="0,0,0,4"
                   ToolTip="How long the cursor has to stay on a thumbnail before the full-size hover preview pops up.&#10;Takes effect on the very next hover - no restart needed." />
        <DockPanel Margin="0,0,0,12"
                   ToolTip="How long the cursor has to stay on a thumbnail before the full-size hover preview pops up.&#10;Takes effect on the very next hover - no restart needed.">
            <TextBlock DockPanel.Dock="Right" Text="{Binding ElementName=HoverDelaySlider, Path=Value, StringFormat={}{0:0.00}s}"
                       Width="42" Margin="4,0,0,0" VerticalAlignment="Center" />
            <Slider x:Name="HoverDelaySlider" Minimum="0" Maximum="2" TickFrequency="0.05" IsSnapToTickEnabled="True" />
        </DockPanel>

        <CheckBox x:Name="SkipResolvedPhotosCheckBox" Content="Skip fully-tagged photos when running Detect Faces"
                  Margin="0,0,0,12"
                  ToolTip="Once every face detected in a photo is tagged, marked &lt;unknown&gt;, or deleted (e.g. via Tag Faces' &quot;All tagged&quot; button), there's nothing left to find - skip re-running the ML detector on it.&#10;Turn off for a deliberate full rescan of everything, e.g. after switching to a better detector model." />

        <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,12">
            Changes take effect the next time you start VRC Photo Manager.
        </TextBlock>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Padding="16,4" Margin="0,0,8,0" Click="CancelButton_Click" />
            <Button Content="Save" Padding="16,4" Click="SaveButton_Click" IsDefault="True" />
        </StackPanel>
    </StackPanel>

    <StackPanel Grid.Column="2">
        <TextBlock Text="Upload Crop Presets" FontSize="16" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,12">
            Reference only for now, not editable here. While hovering a photo, press [ / ] to
            cycle it through these ratios - see the README's Keyboard Shortcuts section.
        </TextBlock>
        <ItemsControl x:Name="CropPresetsList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="0,6">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" />
                            <TextBlock Text="{Binding Detail}" Foreground="Gray" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
    </Grid>
</Window>
