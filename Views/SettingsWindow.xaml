<Window x:Class="VrcPhotoManager.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="820" SizeToContent="Height"
        ResizeMode="NoResize">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- "*" (not "Auto") is what actually makes the ScrollViewer below constrain/scroll
                 its content instead of just reporting its full natural desired height regardless
                 of the window's capped size - an "Auto" row lets a Grid child claim as much space
                 as it wants during arrange, which pushed rows 1/2 (the note text and Save/Cancel
                 buttons) below the window's actual visible bottom edge even with MaxHeight set on
                 the Window itself (confirmed directly - this was still happening before this
                 fix). -->
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <TabControl MinHeight="480">
            <TabItem Header="Models">
                <StackPanel Margin="12">
                    <TextBlock Text="WD14 Nudity Classifier Model" FontSize="14" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,12">
                        Used by "Classify Ratings". Model: SmilingWolf/wd-vit-tagger-v3 (Hugging Face).
                    </TextBlock>

                    <TextBlock Text="Model folder (model.onnx + selected_tags.csv):" Margin="0,0,0,4" />
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="Browse..." Padding="8,2" Margin="8,0,0,0" Click="BrowseModelDir_Click" />
                        <TextBox x:Name="ModelDirTextBox" VerticalContentAlignment="Center" />
                    </DockPanel>

                    <DockPanel Margin="0,0,0,12" LastChildFill="True">
                        <Button x:Name="DownloadButton" DockPanel.Dock="Left" Content="Download Model Files"
                                Padding="8,4" Margin="0,0,8,0" Click="DownloadModel_Click"
                                ToolTip="Download the WD14 model (~378 MB) and tag list into the folder above." />
                        <TextBlock x:Name="DownloadStatusText" TextWrapping="Wrap" Foreground="Gray" FontSize="11" VerticalAlignment="Center" />
                    </DockPanel>

                    <TextBlock Text="CCIP Face-Matching Model" FontSize="14" FontWeight="Bold" Margin="0,12,0,4" />
                    <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,12">
                        Used by "Suggest Faces". Model: deepghs/ccip_onnx, caformer-24-randaug-pruned variant
                        (Hugging Face) - contrastively trained to tell anime characters apart, unlike a
                        general-purpose CLIP model.
                    </TextBlock>

                    <TextBlock Text="Model folder (model_feat.onnx + model_metrics.onnx):" Margin="0,0,0,4" />
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="Browse..." Padding="8,2" Margin="8,0,0,0" Click="BrowseCcipModelDir_Click" />
                        <TextBox x:Name="CcipModelDirTextBox" VerticalContentAlignment="Center" />
                    </DockPanel>

                    <DockPanel Margin="0,0,0,12" LastChildFill="True">
                        <Button x:Name="DownloadCcipButton" DockPanel.Dock="Left" Content="Download CCIP Model Files"
                                Padding="8,4" Margin="0,0,8,0" Click="DownloadCcipModel_Click"
                                ToolTip="Download the CCIP model files into the folder above." />
                        <TextBlock x:Name="DownloadCcipStatusText" TextWrapping="Wrap" Foreground="Gray" FontSize="11" VerticalAlignment="Center" />
                    </DockPanel>

                    <TextBlock Text="Face Detection Model" FontSize="14" FontWeight="Bold" Margin="0,12,0,4" />
                    <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,12">
                        Used by "Detect Faces". Model: deepghs/anime_face_detection, face_detect_v1.4_s
                        variant (Hugging Face, YOLOv8s) - noticeably better recall than the previously
                        bundled LBP cascade, especially on close-up multi-person photos.
                    </TextBlock>

                    <TextBlock Text="Model folder (model.onnx):" Margin="0,0,0,4" />
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="Browse..." Padding="8,2" Margin="8,0,0,0" Click="BrowseFaceDetectionModelDir_Click" />
                        <TextBox x:Name="FaceDetectionModelDirTextBox" VerticalContentAlignment="Center" />
                    </DockPanel>

                    <DockPanel Margin="0,0,0,12" LastChildFill="True">
                        <Button x:Name="DownloadFaceDetectionButton" DockPanel.Dock="Left" Content="Download Face Detection Model"
                                Padding="8,4" Margin="0,0,8,0" Click="DownloadFaceDetectionModel_Click"
                                ToolTip="Download the face detection model (~45 MB) into the folder above." />
                        <TextBlock x:Name="DownloadFaceDetectionStatusText" TextWrapping="Wrap" Foreground="Gray" FontSize="11" VerticalAlignment="Center" />
                    </DockPanel>

                    <TextBlock Text="Avatar Type Classifier" FontSize="14" FontWeight="Bold" Margin="0,12,0,4" />
                    <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,12">
                        Used by "Classify Avatars". Model: misonyah/vrc-avatar-classifier (Hugging Face).
                    </TextBlock>

                    <TextBlock Text="Model folder (model.onnx + labels.txt):" Margin="0,0,0,4" />
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="Browse..." Padding="8,2" Margin="8,0,0,0" Click="BrowseAvatarModelDir_Click" />
                        <TextBox x:Name="AvatarModelDirTextBox" VerticalContentAlignment="Center" />
                    </DockPanel>

                    <DockPanel Margin="0,0,0,12" LastChildFill="True">
                        <Button x:Name="DownloadAvatarButton" DockPanel.Dock="Left" Content="Download Avatar Model Files"
                                Padding="8,4" Margin="0,0,8,0" Click="DownloadAvatarModel_Click"
                                ToolTip="Downloads model.onnx and labels.txt into the folder above." />
                        <TextBlock x:Name="DownloadAvatarStatusText" TextWrapping="Wrap" Foreground="Gray" FontSize="11" VerticalAlignment="Center" />
                    </DockPanel>

                    <TextBlock Text="Avatar Body Detection (optional)" FontSize="14" FontWeight="Bold" Margin="0,12,0,4" />
                    <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,12">
                        Lets "Classify Avatars" identify each avatar separately in a group photo instead of
                        one whole-frame guess. Model: deepghs/anime_person_detection (Hugging Face). Entirely
                        optional - without this, Classify Avatars keeps its original single-guess behavior.
                    </TextBlock>

                    <TextBlock Text="Model folder (model.onnx):" Margin="0,0,0,4" />
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="Browse..." Padding="8,2" Margin="8,0,0,0" Click="BrowseAvatarBodyModelDir_Click" />
                        <TextBox x:Name="AvatarBodyModelDirTextBox" VerticalContentAlignment="Center" />
                    </DockPanel>

                    <DockPanel Margin="0,0,0,12" LastChildFill="True">
                        <Button x:Name="DownloadAvatarBodyButton" DockPanel.Dock="Left" Content="Download Avatar Body Detection Model"
                                Padding="8,4" Margin="0,0,8,0" Click="DownloadAvatarBodyModel_Click"
                                ToolTip="Download the avatar body detection model (~45 MB) into the folder above." />
                        <TextBlock x:Name="DownloadAvatarBodyStatusText" TextWrapping="Wrap" Foreground="Gray" FontSize="11" VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </TabItem>

            <TabItem Header="Upload &amp; Sharing">
                <StackPanel Margin="12">
                    <TextBlock Text="Upload Image Format" FontSize="14" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,8">
                        JPEG (default) is smaller and uses less of your VRCDN quota. PNG is lossless (larger
                        files, no compression artifacts) but otherwise behaves identically - still no
                        metadata attached, same resize/crop handling. The cloud badge on a PNG upload shows
                        gray instead of cyan as a reminder which one it is.
                    </TextBlock>
                    <ComboBox x:Name="UploadFormatBox" Margin="0,0,0,12">
                        <ComboBoxItem Content="jpg" ToolTip="Smaller files, lossy compression - the default." />
                        <ComboBoxItem Content="png" ToolTip="Lossless, larger files - uses more VRCDN quota per photo." />
                    </ComboBox>

                    <TextBlock Text="Upload Crop Presets" FontSize="14" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,12">
                        Reference only for now, not editable here. While hovering a photo, press [ / ] to
                        cycle it through these ratios - see the README's Keyboard Shortcuts section.
                    </TextBlock>
                    <ItemsControl x:Name="CropPresetsList" Margin="0,0,0,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="0,6">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" />
                                        <TextBlock Text="{Binding Detail}" Foreground="Gray" FontSize="11" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="VRCDN Photo Index (for a Udon world script)" FontSize="14" FontWeight="Bold" Margin="0,12,0,4" />
                    <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,8">
                        "Update VRCDN Index" (main window) publishes a list of every currently-uploaded
                        photo's URL to a GitHub Gist, so a Udon world script can randomly pick one - see the
                        README's Keyboard Shortcuts section. Needs a GitHub token with ONLY the "gist" scope
                        (not repository access) - click below to generate one with that scope pre-selected,
                        then paste it here.
                    </TextBlock>
                    <TextBlock Margin="0,0,0,4">
                        <Hyperlink Click="GenerateGistTokenLink_Click">Generate a gist-scope token on GitHub...</Hyperlink>
                    </TextBlock>
                    <PasswordBox x:Name="GistTokenBox" Margin="0,0,0,8"
                                 ToolTip="Pasted here only to save it (DPAPI-encrypted, tied to your Windows account) - never shown again in plain text after Save." />
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Index filename (no extension):" Margin="0,0,0,4" />
                            <TextBox x:Name="IndexFileNameBox"
                                     ToolTip="Just a label in the gist - VRCDN isn't involved, and the gist's URL doesn't depend on this. Defaults to a random id the first time you open Settings after using this feature." />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Format:" Margin="0,0,0,4" />
                            <ComboBox x:Name="IndexFormatBox" SelectedIndex="0">
                                <ComboBoxItem Content="csv" ToolTip="url,width,height per line, no header - easiest to parse in Udon, and lets a display quad size itself before the image loads." />
                                <ComboBoxItem Content="txt" ToolTip="One URL per line." />
                                <ComboBoxItem Content="json" ToolTip="Array of {Url,Width,Height} objects - needs VRChat's VRCJson.TryDeserializeFromJson node in Udon." />
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="IndexUrlText" TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,12" />
                </StackPanel>
            </TabItem>

            <TabItem Header="General">
                <StackPanel Margin="12">
                    <CheckBox x:Name="AutoCopyUrlCheckBox" Content="Automatically copy VRCDN URL to clipboard when hovering a photo"
                              Margin="0,0,0,12"
                              ToolTip="Automatically copy the photo's VRCDN URL to your clipboard whenever you hover over it.&#10;Clears the clipboard instead if the photo isn't uploaded yet." />

                    <TextBlock Text="Preview pop-up delay:" Margin="0,0,0,4"
                               ToolTip="How long the cursor has to stay on a thumbnail before the full-size hover preview pops up.&#10;Takes effect on the very next hover - no restart needed." />
                    <DockPanel Margin="0,0,0,12"
                               ToolTip="How long the cursor has to stay on a thumbnail before the full-size hover preview pops up.&#10;Takes effect on the very next hover - no restart needed.">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ElementName=HoverDelaySlider, Path=Value, StringFormat={}{0:0.00}s}"
                                   Width="42" Margin="4,0,0,0" VerticalAlignment="Center" />
                        <Slider x:Name="HoverDelaySlider" Minimum="0" Maximum="2" TickFrequency="0.05" IsSnapToTickEnabled="True" />
                    </DockPanel>

                    <CheckBox x:Name="SkipResolvedPhotosCheckBox" Content="Skip fully-tagged photos when running Detect Faces"
                              Margin="0,0,0,12"
                              ToolTip="Once every face detected in a photo is tagged, marked &lt;unknown&gt;, or deleted (e.g. via Tag Faces' &quot;All tagged&quot; button), there's nothing left to find - skip re-running the ML detector on it.&#10;Turn off for a deliberate full rescan of everything, e.g. after switching to a better detector model." />

                    <CheckBox x:Name="EnableExifEliminationCheckBox" Content="Identify the last person in a photo by elimination (VRCX presence data)"
                              Margin="0,0,0,12"
                              ToolTip="When a photo's VRCX presence data lists everyone who was there, and exactly one person is left unaccounted for while exactly one face is still unidentified, tag that face as that person - no face-matching involved, just elimination.&#10;A photo with VRCX's own native metadata auto-confirms directly; one relying on the weaker gamelog-inferred fallback lands as a normal pending suggestion instead." />

                    <TextBlock Text="Portal-hop detection window:" Margin="0,0,0,4"
                               ToolTip="How close a friend's departure from your previous instance and arrival into a photo's instance need to be to your own transition to count as &quot;traveled together&quot; (Photo Metadata's Traveled Together section).&#10;A real portal/invite hop isn't perfectly synchronized - you might go through before or after everyone else - so this needs some slack." />
                    <DockPanel Margin="0,0,0,12"
                               ToolTip="How close a friend's departure from your previous instance and arrival into a photo's instance need to be to your own transition to count as &quot;traveled together&quot; (Photo Metadata's Traveled Together section).&#10;A real portal/invite hop isn't perfectly synchronized - you might go through before or after everyone else - so this needs some slack.">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ElementName=PortalHopWindowSlider, Path=Value, StringFormat={}{0:0}s}"
                                   Width="32" Margin="4,0,0,0" VerticalAlignment="Center" />
                        <Slider x:Name="PortalHopWindowSlider" Minimum="15" Maximum="180" TickFrequency="15" IsSnapToTickEnabled="True" />
                    </DockPanel>

                    <TextBlock Text="Discord cache size cap:" Margin="0,0,0,4"
                               ToolTip="Maximum disk space the downloaded full-size Discord photo cache is allowed to use before older cached originals get evicted (fully face-tagged photos first, then oldest-accessed).&#10;Evicted photos aren't lost - they're just re-downloaded from Discord on demand next time they're needed." />
                    <DockPanel Margin="0,0,0,12"
                               ToolTip="Maximum disk space the downloaded full-size Discord photo cache is allowed to use before older cached originals get evicted (fully face-tagged photos first, then oldest-accessed).&#10;Evicted photos aren't lost - they're just re-downloaded from Discord on demand next time they're needed.">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ElementName=DiscordCacheSizeLimitSlider, Path=Value, StringFormat={}{0:0} GB}"
                                   Width="52" Margin="4,0,0,0" VerticalAlignment="Center" />
                        <Slider x:Name="DiscordCacheSizeLimitSlider" Minimum="1" Maximum="50" TickFrequency="1" IsSnapToTickEnabled="True" />
                    </DockPanel>
                </StackPanel>
            </TabItem>

            <TabItem Header="Avatars">
                <DockPanel Margin="12">
                    <TextBox x:Name="AvatarCatalogSearchTextBox" DockPanel.Dock="Top" Margin="0,0,0,8"
                             TextChanged="AvatarCatalogSearchTextBox_TextChanged"
                             ToolTip="Search cataloged avatars by name." />
                    <Button x:Name="EditAvatarCatalogButton" DockPanel.Dock="Bottom" Content="Edit catalog info..."
                            Margin="0,8,0,0" HorizontalAlignment="Left" Padding="8,2" IsEnabled="False"
                            Click="EditAvatarCatalogButton_Click"
                            ToolTip="Add Booth/Gumroad/Jinxxy links and a parent avatar for the selected entry." />
                    <ListBox x:Name="AvatarCatalogListBox" MaxHeight="320" ScrollViewer.VerticalScrollBarVisibility="Auto"
                             SelectionChanged="AvatarCatalogListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,2">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" />
                                    <TextBlock FontSize="11" Foreground="Gray">
                                        <Run Text="{Binding StoresText, Mode=OneWay}" />
                                        <Run Text=" " />
                                        <Run Text="{Binding ParentText, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>

            <TabItem Header="Library">
                <DockPanel Margin="12">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="AddLocalFolderButton" Content="Add local folder..." Padding="8,4" Margin="0,0,8,0"
                                Click="AddLocalFolderButton_Click"
                                ToolTip="Add another local folder to scan as part of your photo library." />
                        <Button x:Name="AddDiscordChannelButton" Content="Add Discord channel..." Padding="8,4" Margin="0,0,8,0"
                                Click="AddDiscordChannelButton_Click"
                                ToolTip="Add a Discord channel as a photo library. Needs a bot token the first time - see the tooltip on the token box below." />
                        <Button x:Name="ChangeDiscordTokenButton" Content="Change Discord token..." Padding="8,4"
                                Click="ChangeDiscordTokenButton_Click"
                                ToolTip="Re-enter the Discord bot token, e.g. if it was regenerated or was wrong the first time." />
                    </StackPanel>
                    <StackPanel x:Name="DiscordTokenSetupPanel" DockPanel.Dock="Top" Margin="0,0,0,12" Visibility="Collapsed">
                        <TextBlock Margin="0,0,0,8">
                            <Run Text="Set up a Discord bot" FontSize="14" FontWeight="Bold" />
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,8">
                            1. Open
                            <Hyperlink Click="OpenDiscordDevPortalLink_Click">discord.com/developers/applications</Hyperlink>
                            and click "New Application".
                            <LineBreak/>2. Open its "Bot" page, click "Reset Token", then "Copy". Use this exact value below - NOT the Application ID or Client Secret from other pages, that's the most common mistake here.
                            <LineBreak/>3. Still on the Bot page, enable "Message Content Intent" under Privileged Gateway Intents.
                            <LineBreak/>4. On the "General Information" page, copy the Application ID, paste it below, then click "Open invite link" - it's pre-filled with the right permissions (View Channel + Read Message History), no manual OAuth2 setup needed.
                            <LineBreak/>5. Paste the token from step 2 below and click Save.
                        </TextBlock>
                        <Button Content="Open suggested bot icon..." Padding="8,2" HorizontalAlignment="Left" Margin="0,0,0,8"
                                Click="OpenBotIconLocation_Click"
                                ToolTip="Opens a suggested icon you can optionally upload for your bot in step 1, so every VrcPhotoManager bot looks the same." />
                        <TextBlock Text="Discord Application ID:" Margin="0,0,0,4" />
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="Open invite link" Padding="8,2" Margin="8,0,0,0"
                                    Click="OpenDiscordInviteLink_Click"
                                    ToolTip="Opens Discord's own invite page with the bot scope and the exact permissions VrcPhotoManager needs already selected." />
                            <TextBox x:Name="DiscordApplicationIdTextBox" VerticalContentAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="Discord bot token:" Margin="0,0,0,4" />
                        <PasswordBox x:Name="DiscordTokenBox" Margin="0,0,0,4" />
                        <Button Content="Save token" Padding="8,2" HorizontalAlignment="Left" Click="SaveDiscordTokenButton_Click" />
                    </StackPanel>
                    <ListBox x:Name="DiscordChannelPickerListBox" DockPanel.Dock="Top" MaxHeight="200" Visibility="Collapsed"
                             SelectionChanged="DiscordChannelPickerListBox_SelectionChanged" Margin="0,0,0,8" />
                    <ListBox x:Name="LibraryListBox" MaxHeight="320" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock FontWeight="Bold">
                                            <Run Text="{Binding DisplayName}" />
                                            <Run Text=" (" /><Run Text="{Binding TypeText}" /><Run Text=")" />
                                        </TextBlock>
                                        <TextBlock FontSize="11" Foreground="Gray" Text="{Binding DetailText}" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" Margin="8,0"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding Enabled}"
                                              Content="Enabled"
                                              Checked="LibraryEnabledToggle_Changed" Unchecked="LibraryEnabledToggle_Changed"
                                              Tag="{Binding Id}"
                                              ToolTip="When off, this library's photos are hidden from the grid, skipped by Detect Faces/Classify Avatars/Suggest Faces/Classify Ratings, and skipped by Scan Libraries - without removing it or losing already-scanned photos." />
                                    <CheckBox Grid.Column="2" Margin="8,0"
                                              VerticalAlignment="Center"
                                              Visibility="{Binding IsDiscord, Converter={StaticResource BoolToVisibilityConverter}}"
                                              IsChecked="{Binding AutoDownloadOriginals}"
                                              Content="Auto-download"
                                              Checked="AutoDownloadToggle_Changed" Unchecked="AutoDownloadToggle_Changed"
                                              Tag="{Binding Id}" />
                                    <Button Grid.Column="3" Content="Scan now" Padding="8,2" Margin="0,0,8,0"
                                            Click="ScanSingleLibraryButton_Click" Tag="{Binding Id}"
                                            ToolTip="Scan just this library instead of waiting for a full Scan Libraries pass." />
                                    <Button Grid.Column="4" Content="Remove" Padding="8,2"
                                            Click="RemoveLibraryButton_Click" Tag="{Binding Id}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>
        </TabControl>
        </ScrollViewer>

        <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,12,0,12">
            Changes take effect the next time you start VRC Photo Manager.
        </TextBlock>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Padding="16,4" Margin="0,0,8,0" Click="CancelButton_Click" />
            <Button Content="Save" Padding="16,4" Click="SaveButton_Click" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
