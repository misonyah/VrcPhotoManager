<Window x:Class="VrcPhotoManager.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="620" SizeToContent="Height"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" MinHeight="480">
            <TabItem Header="Models">
                <StackPanel Margin="12">
                    <TextBlock Text="WD14 Nudity Classifier Model" FontSize="16" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,12">
                        Used by "Classify Photos". Model: SmilingWolf/wd-vit-tagger-v3 (Hugging Face).
                    </TextBlock>

                    <TextBlock Text="Model folder (model.onnx + selected_tags.csv):" Margin="0,0,0,4" />
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="Browse..." Padding="8,2" Margin="8,0,0,0" Click="BrowseModelDir_Click" />
                        <TextBox x:Name="ModelDirTextBox" VerticalContentAlignment="Center" />
                    </DockPanel>

                    <Button x:Name="DownloadButton" Content="Download Model Files" HorizontalAlignment="Left"
                            Padding="8,4" Margin="0,0,0,8" Click="DownloadModel_Click"
                            ToolTip="Download the WD14 model (~378 MB) and tag list into the folder above." />
                    <TextBlock x:Name="DownloadStatusText" TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,12" MinHeight="16" />

                    <TextBlock Text="CCIP Face-Matching Model" FontSize="16" FontWeight="Bold" Margin="0,12,0,4" />
                    <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,12">
                        Used by "Suggest Faces". Model: deepghs/ccip_onnx, caformer-24-randaug-pruned variant
                        (Hugging Face) - contrastively trained to tell anime characters apart, unlike a
                        general-purpose CLIP model.
                    </TextBlock>

                    <TextBlock Text="Model folder (model_feat.onnx + model_metrics.onnx):" Margin="0,0,0,4" />
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="Browse..." Padding="8,2" Margin="8,0,0,0" Click="BrowseCcipModelDir_Click" />
                        <TextBox x:Name="CcipModelDirTextBox" VerticalContentAlignment="Center" />
                    </DockPanel>

                    <Button x:Name="DownloadCcipButton" Content="Download CCIP Model Files" HorizontalAlignment="Left"
                            Padding="8,4" Margin="0,0,0,8" Click="DownloadCcipModel_Click"
                            ToolTip="Download the CCIP model files into the folder above." />
                    <TextBlock x:Name="DownloadCcipStatusText" TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,12" MinHeight="16" />

                    <TextBlock Text="Face Detection Model" FontSize="16" FontWeight="Bold" Margin="0,12,0,4" />
                    <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,12">
                        Used by "Detect Faces". Model: deepghs/anime_face_detection, face_detect_v1.4_s
                        variant (Hugging Face, YOLOv8s) - noticeably better recall than the previously
                        bundled LBP cascade, especially on close-up multi-person photos.
                    </TextBlock>

                    <TextBlock Text="Model folder (model.onnx):" Margin="0,0,0,4" />
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="Browse..." Padding="8,2" Margin="8,0,0,0" Click="BrowseFaceDetectionModelDir_Click" />
                        <TextBox x:Name="FaceDetectionModelDirTextBox" VerticalContentAlignment="Center" />
                    </DockPanel>

                    <Button x:Name="DownloadFaceDetectionButton" Content="Download Face Detection Model" HorizontalAlignment="Left"
                            Padding="8,4" Margin="0,0,0,8" Click="DownloadFaceDetectionModel_Click"
                            ToolTip="Download the face detection model (~45 MB) into the folder above." />
                    <TextBlock x:Name="DownloadFaceDetectionStatusText" TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,12" MinHeight="16" />

                    <TextBlock Text="Avatar Type Classifier" FontSize="16" FontWeight="Bold" Margin="0,12,0,4" />
                    <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,12">
                        Used by "Classify Avatars". Model: misonyah/vrc-avatar-classifier (Hugging Face).
                    </TextBlock>

                    <TextBlock Text="Model folder (model.onnx + labels.txt):" Margin="0,0,0,4" />
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="Browse..." Padding="8,2" Margin="8,0,0,0" Click="BrowseAvatarModelDir_Click" />
                        <TextBox x:Name="AvatarModelDirTextBox" VerticalContentAlignment="Center" />
                    </DockPanel>

                    <Button x:Name="DownloadAvatarButton" Content="Download Avatar Model Files" HorizontalAlignment="Left"
                            Padding="8,4" Margin="0,0,0,8" Click="DownloadAvatarModel_Click"
                            ToolTip="Downloads model.onnx and labels.txt into the folder above." />
                    <TextBlock x:Name="DownloadAvatarStatusText" TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,12" MinHeight="16" />
                </StackPanel>
            </TabItem>

            <TabItem Header="Upload &amp; Sharing">
                <StackPanel Margin="12">
                    <TextBlock Text="Upload Image Format" FontSize="16" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,8">
                        JPEG (default) is smaller and uses less of your VRCDN quota. PNG is lossless (larger
                        files, no compression artifacts) but otherwise behaves identically - still no
                        metadata attached, same resize/crop handling. The cloud badge on a PNG upload shows
                        gray instead of cyan as a reminder which one it is.
                    </TextBlock>
                    <ComboBox x:Name="UploadFormatBox" Margin="0,0,0,12">
                        <ComboBoxItem Content="jpg" ToolTip="Smaller files, lossy compression - the default." />
                        <ComboBoxItem Content="png" ToolTip="Lossless, larger files - uses more VRCDN quota per photo." />
                    </ComboBox>

                    <TextBlock Text="Upload Crop Presets" FontSize="16" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,12">
                        Reference only for now, not editable here. While hovering a photo, press [ / ] to
                        cycle it through these ratios - see the README's Keyboard Shortcuts section.
                    </TextBlock>
                    <ItemsControl x:Name="CropPresetsList" Margin="0,0,0,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="0,6">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" />
                                        <TextBlock Text="{Binding Detail}" Foreground="Gray" FontSize="11" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="VRCDN Photo Index (for a Udon world script)" FontSize="16" FontWeight="Bold" Margin="0,12,0,4" />
                    <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,8">
                        "Update VRCDN Index" (main window) publishes a list of every currently-uploaded
                        photo's URL to a GitHub Gist, so a Udon world script can randomly pick one - see the
                        README's Keyboard Shortcuts section. Needs a GitHub token with ONLY the "gist" scope
                        (not repository access) - click below to generate one with that scope pre-selected,
                        then paste it here.
                    </TextBlock>
                    <TextBlock Margin="0,0,0,4">
                        <Hyperlink Click="GenerateGistTokenLink_Click">Generate a gist-scope token on GitHub...</Hyperlink>
                    </TextBlock>
                    <PasswordBox x:Name="GistTokenBox" Margin="0,0,0,8"
                                 ToolTip="Pasted here only to save it (DPAPI-encrypted, tied to your Windows account) - never shown again in plain text after Save." />
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Index filename (no extension):" Margin="0,0,0,4" />
                            <TextBox x:Name="IndexFileNameBox"
                                     ToolTip="Just a label in the gist - VRCDN isn't involved, and the gist's URL doesn't depend on this. Defaults to a random id the first time you open Settings after using this feature." />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Format:" Margin="0,0,0,4" />
                            <ComboBox x:Name="IndexFormatBox" SelectedIndex="0">
                                <ComboBoxItem Content="csv" ToolTip="url,width,height per line, no header - easiest to parse in Udon, and lets a display quad size itself before the image loads." />
                                <ComboBoxItem Content="txt" ToolTip="One URL per line." />
                                <ComboBoxItem Content="json" ToolTip="Array of {Url,Width,Height} objects - needs VRChat's VRCJson.TryDeserializeFromJson node in Udon." />
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="IndexUrlText" TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,12" />
                </StackPanel>
            </TabItem>

            <TabItem Header="General">
                <StackPanel Margin="12">
                    <CheckBox x:Name="AutoCopyUrlCheckBox" Content="Automatically copy VRCDN URL to clipboard when hovering a photo"
                              Margin="0,0,0,12"
                              ToolTip="Automatically copy the photo's VRCDN URL to your clipboard whenever you hover over it.&#10;Clears the clipboard instead if the photo isn't uploaded yet." />

                    <TextBlock Text="Preview pop-up delay:" Margin="0,0,0,4"
                               ToolTip="How long the cursor has to stay on a thumbnail before the full-size hover preview pops up.&#10;Takes effect on the very next hover - no restart needed." />
                    <DockPanel Margin="0,0,0,12"
                               ToolTip="How long the cursor has to stay on a thumbnail before the full-size hover preview pops up.&#10;Takes effect on the very next hover - no restart needed.">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ElementName=HoverDelaySlider, Path=Value, StringFormat={}{0:0.00}s}"
                                   Width="42" Margin="4,0,0,0" VerticalAlignment="Center" />
                        <Slider x:Name="HoverDelaySlider" Minimum="0" Maximum="2" TickFrequency="0.05" IsSnapToTickEnabled="True" />
                    </DockPanel>

                    <CheckBox x:Name="SkipResolvedPhotosCheckBox" Content="Skip fully-tagged photos when running Detect Faces"
                              Margin="0,0,0,12"
                              ToolTip="Once every face detected in a photo is tagged, marked &lt;unknown&gt;, or deleted (e.g. via Tag Faces' &quot;All tagged&quot; button), there's nothing left to find - skip re-running the ML detector on it.&#10;Turn off for a deliberate full rescan of everything, e.g. after switching to a better detector model." />
                </StackPanel>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,12,0,12">
            Changes take effect the next time you start VRC Photo Manager.
        </TextBlock>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Padding="16,4" Margin="0,0,8,0" Click="CancelButton_Click" />
            <Button Content="Save" Padding="16,4" Click="SaveButton_Click" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
