<Window x:Class="VrcPhotoManager.Views.FilterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:VrcPhotoManager.Views"
        Title="Filter Photos" Height="540" Width="300" ResizeMode="CanResizeWithGrip"
        WindowStyle="ToolWindow" ShowInTaskbar="False">
    <StackPanel Margin="12">
        <TextBlock Text="Rating:" Margin="0,0,0,4"
                   ToolTip="Filter by the content rating you've assigned this photo.&#10;'(none)' means it hasn't been rated yet - Classify Photos can suggest one." />
        <ComboBox ItemsSource="{Binding RatingFilterOptions}" SelectedItem="{Binding RatingFilter}" Margin="0,0,0,12"
                  ToolTip="Filter by the content rating you've assigned this photo.&#10;'(none)' means it hasn't been rated yet - Classify Photos can suggest one." />

        <TextBlock Text="Status:" Margin="0,0,0,4" ToolTip="Filter by VRCDN upload status." />
        <ComboBox ItemsSource="{Binding StatusFilterOptions}" SelectedItem="{Binding StatusFilter}" Margin="0,0,0,12"
                  ToolTip="Filter by VRCDN upload status." />

        <TextBlock Text="Avatar:" Margin="0,0,0,4"
                   ToolTip="Filter by detected avatar base. 'Unclassified' means Classify Avatars hasn't run on it yet; 'No confident match' means it ran but wasn't confident enough to guess." />
        <ComboBox ItemsSource="{Binding AvatarTypeFilterOptions}" SelectedItem="{Binding AvatarTypeFilter}" Margin="0,0,0,12"
                  ToolTip="Filter by detected avatar base. 'Unclassified' means Classify Avatars hasn't run on it yet; 'No confident match' means it ran but wasn't confident enough to guess.">
            <ComboBox.ItemContainerStyle>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="ToolTip" Value="{Binding}" />
                </Style>
            </ComboBox.ItemContainerStyle>
        </ComboBox>

        <!-- Same PlayerFilterPicker UserControl MainWindow's filter bar uses - both just need
             DataContext set to the same MainViewModel, so the search-as-you-type/Tab-complete
             behavior comes for free instead of being a second copy of that code-behind. -->
        <TextBlock Text="Player:" Margin="0,0,0,4"
                   ToolTip="Search for a player to filter the photo list.&#10;Also matches old names and stylized usernames.&#10;&#10;'(tagged)' = you've confirmed a face tag for them.&#10;'(manual)' = added by name, not yet linked to a VRC account." />
        <views:PlayerFilterPicker x:Name="PlayerFilterPicker" Height="24" Margin="0,0,0,4" HorizontalAlignment="Stretch" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <CheckBox Content="Tagged only" IsChecked="{Binding TaggedOnlyFilter}" IsEnabled="{Binding CanFilterTaggedOnly}"
                      Margin="0,0,16,0"
                      ToolTip="Only show photos where you've confirmed a face tag for this person.&#10;Turn off to also include photos where VRCX just recorded them as present." />
            <CheckBox Content="Own only" IsChecked="{Binding OwnPhotosOnlyFilter}" IsEnabled="{Binding CanFilterOwnPhotosOnly}"
                      ToolTip="Only show photos VRChat itself recorded you as the photographer for (via embedded PNG metadata).&#10;Excludes photos taken by someone else in the same instance, even if they ended up in your library." />
        </StackPanel>

        <TextBlock Text="Faces:" Margin="0,0,0,4"
                   ToolTip="Show only photos with (or without) a detected face.&#10;Run Detect Faces first to populate this." />
        <ComboBox ItemsSource="{Binding FaceCountFilterOptions}" SelectedItem="{Binding FaceCountFilter}" Margin="0,0,0,12"
                  ToolTip="Show only photos with (or without) a detected face.&#10;Run Detect Faces first to populate this." />

        <TextBlock Text="People in world:" Margin="0,0,0,4"
                   ToolTip="Filter by how many people VRCX recorded in the instance when the photo was taken.&#10;This is VRCX's headcount, not the number of detected faces." />
        <ComboBox ItemsSource="{Binding PlayerCountFilterOptions}" SelectedItem="{Binding PlayerCountFilter}" Margin="0,0,0,12"
                  ToolTip="Filter by how many people VRCX recorded in the instance when the photo was taken.&#10;This is VRCX's headcount, not the number of detected faces." />

        <TextBlock Text="Face-match confidence:" Margin="0,0,0,4"
                   ToolTip="Hide face-match suggestions below this confidence.&#10;All the way left = off (show everything).&#10;This isn't a percentage - most good matches fall between about 0.15 and 0.5, so the slider is scaled to that range." />
        <DockPanel Margin="0,0,0,12"
                   ToolTip="Hide face-match suggestions below this confidence.&#10;All the way left = off (show everything).&#10;This isn't a percentage - most good matches fall between about 0.15 and 0.5, so the slider is scaled to that range.">
            <TextBlock DockPanel.Dock="Right" Text="{Binding MinSuggestionConfidenceLabel}" Width="32" Margin="4,0,0,0" />
            <Slider Minimum="0" Maximum="0.5" Value="{Binding MinSuggestionConfidence}" />
        </DockPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Clear Filters" Padding="16,4" Margin="0,0,8,0" Click="ClearFiltersButton_Click"
                    ToolTip="Reset every filter above back to &quot;show everything&quot;." />
            <Button Content="Close" Padding="16,4" Click="CloseButton_Click" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
