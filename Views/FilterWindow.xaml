<Window x:Class="VrcPhotoManager.Views.FilterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:VrcPhotoManager.Views"
        Title="Filter Photos" Width="300" MinHeight="460" MaxHeight="900"
        SizeToContent="Height" ResizeMode="CanResizeWithGrip"
        WindowStyle="ToolWindow" ShowInTaskbar="False">
    <Window.Resources>
        <views:RequireExcludeTextConverter x:Key="RequireExcludeTextConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>
    <!-- SizeToContent="Height" above makes the window grow/shrink with the player-filter list
         (each added/removed row changes the StackPanel's desired height) - MaxHeight caps that
         growth once there are enough rows to fill most of a screen, at which point this
         ScrollViewer takes over instead of the window running off-screen. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="12">
        <TextBlock Text="Rating:" Margin="0,0,0,4"
                   ToolTip="Filter by the content rating you've assigned this photo.&#10;'(none)' means it hasn't been rated yet - Classify Photos can suggest one." />
        <ComboBox ItemsSource="{Binding RatingFilterOptions}" SelectedItem="{Binding RatingFilter}" Margin="0,0,0,12"
                  ToolTip="Filter by the content rating you've assigned this photo.&#10;'(none)' means it hasn't been rated yet - Classify Photos can suggest one." />

        <TextBlock Text="Status:" Margin="0,0,0,4" ToolTip="Filter by VRCDN upload status." />
        <ComboBox ItemsSource="{Binding StatusFilterOptions}" SelectedItem="{Binding StatusFilter}" Margin="0,0,0,12"
                  ToolTip="Filter by VRCDN upload status." />

        <TextBlock Text="Avatar:" Margin="0,0,0,4"
                   ToolTip="Filter by detected avatar base. 'Unclassified' means Classify Avatars hasn't run on it yet; 'No confident match' means it ran but wasn't confident enough to guess." />
        <ComboBox ItemsSource="{Binding AvatarTypeFilterOptions}" SelectedItem="{Binding AvatarTypeFilter}" Margin="0,0,0,12"
                  ToolTip="Filter by detected avatar base. 'Unclassified' means Classify Avatars hasn't run on it yet; 'No confident match' means it ran but wasn't confident enough to guess.">
            <ComboBox.ItemContainerStyle>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="ToolTip" Value="{Binding}" />
                </Style>
            </ComboBox.ItemContainerStyle>
        </ComboBox>

        <!-- One row per PlayerFilterCriteria entry (always ends with one empty row - see
             MainViewModel.EnsurePlayerFilterCriteriaShape) - picking a player in what was the
             last row automatically reveals a fresh empty one beneath it, so this list grows on
             its own as you fill it in. Each row reuses the same PlayerFilterPicker UserControl
             MainWindow's filter bar uses (CollapseWhenMultiple=False here - unlike that single
             global box, each row always shows exactly its own player, never a "N filtered"
             summary), bound to its own PlayerFilterRow.Option rather than the shared
             SelectedPlayerFilter, so multiple players can be selected independently. -->
        <TextBlock Text="Players (all required unless marked Excludes):" Margin="0,0,0,4" TextWrapping="Wrap"
                   ToolTip="Search for a player to filter the photo list.&#10;Also matches old names and stylized usernames.&#10;&#10;'(tagged)' = you've confirmed a face tag for them.&#10;'(manual)' = added by name, not yet linked to a VRC account.&#10;&#10;A photo must include every &quot;Requires&quot; player and none of the &quot;Excludes&quot; ones - e.g. add yourself as Excludes to find photos of everyone but you." />
        <ItemsControl ItemsSource="{Binding PlayerFilterCriteria}" Margin="0,0,0,4">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ToggleButton Grid.Column="0" Width="60" Margin="0,0,4,0"
                                      IsChecked="{Binding Exclude}"
                                      Content="{Binding Exclude, Converter={StaticResource RequireExcludeTextConverter}}"
                                      ToolTip="Toggle whether the photo must include this player (Requires) or must NOT include them (Excludes) - e.g. Excludes yourself to find photos of everyone but you.">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Background" Value="MediumSeaGreen" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Exclude}" Value="True">
                                            <Setter Property="Background" Value="IndianRed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                        <views:PlayerFilterPicker Grid.Column="1" Height="24"
                                                   SelectedOption="{Binding Option, Mode=TwoWay}"
                                                   SearchSource="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   CollapseWhenMultiple="False" />
                        <Button Grid.Column="2" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                Width="22" Margin="4,0,0,0"
                                Visibility="{Binding HasPlayer, Converter={StaticResource BoolToVisibilityConverter}}"
                                Click="RemovePlayerFilterRow_Click"
                                ToolTip="Remove this player filter." />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <CheckBox Content="Tagged only" IsChecked="{Binding TaggedOnlyFilter}" IsEnabled="{Binding CanFilterTaggedOnly}"
                      Margin="0,0,16,0"
                      ToolTip="Only show photos where you've confirmed a face tag for this person.&#10;Turn off to also include photos where VRCX just recorded them as present." />
            <CheckBox Content="Own only" IsChecked="{Binding OwnPhotosOnlyFilter}" IsEnabled="{Binding CanFilterOwnPhotosOnly}"
                      ToolTip="Only show photos VRChat itself recorded you as the photographer for (via embedded PNG metadata).&#10;Excludes photos taken by someone else in the same instance, even if they ended up in your library." />
        </StackPanel>

        <TextBlock Text="Faces:" Margin="0,0,0,4"
                   ToolTip="Show only photos with (or without) a detected face.&#10;Run Detect Faces first to populate this." />
        <ComboBox ItemsSource="{Binding FaceCountFilterOptions}" SelectedItem="{Binding FaceCountFilter}" Margin="0,0,0,12"
                  ToolTip="Show only photos with (or without) a detected face.&#10;Run Detect Faces first to populate this." />

        <TextBlock Text="People in world:" Margin="0,0,0,4"
                   ToolTip="Filter by how many people VRCX recorded in the instance when the photo was taken.&#10;This is VRCX's headcount, not the number of detected faces." />
        <ComboBox ItemsSource="{Binding PlayerCountFilterOptions}" SelectedItem="{Binding PlayerCountFilter}" Margin="0,0,0,12"
                  ToolTip="Filter by how many people VRCX recorded in the instance when the photo was taken.&#10;This is VRCX's headcount, not the number of detected faces." />

        <TextBlock Text="Face-match confidence:" Margin="0,0,0,4"
                   ToolTip="Hide face-match suggestions below this confidence.&#10;All the way left = off (show everything).&#10;This isn't a percentage - most good matches fall between about 0.15 and 0.5, so the slider is scaled to that range." />
        <DockPanel Margin="0,0,0,12"
                   ToolTip="Hide face-match suggestions below this confidence.&#10;All the way left = off (show everything).&#10;This isn't a percentage - most good matches fall between about 0.15 and 0.5, so the slider is scaled to that range.">
            <TextBlock DockPanel.Dock="Right" Text="{Binding MinSuggestionConfidenceLabel}" Width="32" Margin="4,0,0,0" />
            <Slider Minimum="0" Maximum="0.5" Value="{Binding MinSuggestionConfidence}" />
        </DockPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Clear Filters" Padding="16,4" Margin="0,0,8,0" Click="ClearFiltersButton_Click"
                    ToolTip="Reset every filter above back to &quot;show everything&quot;." />
            <Button Content="Close" Padding="16,4" Click="CloseButton_Click" IsDefault="True" />
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</Window>
