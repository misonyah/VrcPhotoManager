<Window x:Class="VrcPhotoManager.Views.MetadataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Photo Metadata" Height="420" Width="480"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBox x:Name="MetadataText" IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" />
        <Button Grid.Row="1" Content="Close" HorizontalAlignment="Right" Margin="0,12,0,0"
                Padding="16,4" Click="CloseButton_Click" IsDefault="True" />
    </Grid>
</Window>
