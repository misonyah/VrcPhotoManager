<Window x:Class="VrcPhotoManager.Views.MetadataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Photo Metadata" Height="420" Width="480">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- FlowDocumentScrollViewer instead of RichTextBox: a read-only RichTextBox still
             intercepts left-clicks for caret placement/text selection before they reach an
             embedded Hyperlink, so Hyperlink.Click never fires even though the link renders
             underlined - confirmed live (links looked clickable, did nothing). This viewer has
             no selection/caret behavior to conflict with, so Hyperlink.Click fires normally. -->
        <FlowDocumentScrollViewer x:Name="MetadataText"
                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" />
        <Button Grid.Row="1" Content="Close" HorizontalAlignment="Right" Margin="0,12,0,0"
                Padding="16,4" Click="CloseButton_Click" IsDefault="True" />
    </Grid>
</Window>
