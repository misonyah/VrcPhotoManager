<Window x:Class="VrcPhotoManager.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About VRC Photo Manager" Width="440" SizeToContent="Height"
        ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock Text="VRC Photo Manager" FontSize="20" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock Text="An unofficial, community-made tool for curating and uploading VRChat photos to VRCDN object storage." TextWrapping="Wrap" Margin="0,0,0,12" />

        <Border Background="#332B1B" BorderBrush="#8A6D1E" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,12">
            <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#FFDFA3">
                This project is <Run FontWeight="Bold">not affiliated with, endorsed by, or connected to VRCDN</Run> in any way.
                It talks to VRCDN's own panel via a reverse-engineered API discovered through
                normal browser inspection - not a published integration. VRCDN could change or
                break it at any time without notice.
            </TextBlock>
        </Border>

        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12">
            "VRCDN" is a trademark of its respective owner. This tool's icon is an original
            design and does not use VRCDN's logo or branding.
        </TextBlock>

        <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11">
            Source available on GitHub. Licensed under the MIT License.
        </TextBlock>

        <Button Content="Close" HorizontalAlignment="Right" Margin="0,16,0,0" Padding="16,4"
                Click="CloseButton_Click" IsDefault="True" />
    </StackPanel>
</Window>
