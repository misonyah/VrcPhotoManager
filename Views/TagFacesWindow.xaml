<Window x:Class="VrcPhotoManager.Views.TagFacesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tag Faces" Height="700" Width="900"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- LayoutTransform (not RenderTransform) on the shared Image+Canvas container: it
             affects the layout pass, so the ScrollViewer correctly grows its scrollable extent
             as you zoom in, and it applies to the whole container as one visual unit - the face
             boxes on FaceCanvas are positioned using PhotoImage's own (pre-transform) ActualWidth/
             Height, so they stay correctly aligned at any zoom level without extra math. -->
        <ScrollViewer x:Name="ImageScrollViewer" Grid.Row="0"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      PreviewMouseWheel="ImageScrollViewer_PreviewMouseWheel"
                      PreviewMouseDown="ImageScrollViewer_PreviewMouseDown"
                      PreviewMouseMove="ImageScrollViewer_PreviewMouseMove"
                      PreviewMouseUp="ImageScrollViewer_PreviewMouseUp"
                      LostMouseCapture="ImageScrollViewer_LostMouseCapture">
            <Grid x:Name="ImageContainer">
                <Grid.LayoutTransform>
                    <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1" />
                </Grid.LayoutTransform>
                <Image x:Name="PhotoImage" Stretch="Uniform" SizeChanged="PhotoImage_SizeChanged" />
                <!-- Aliased (not anti-aliased): face-box strokes are always exactly 1 device
                     pixel wide regardless of zoom (see RedrawBoxes' StrokeThickness math) - at
                     that width, anti-aliasing just spreads the line across 2 semi-transparent
                     pixels, making it look faint/missing at low zoom instead of crisp. -->
                <Canvas x:Name="FaceCanvas" Background="Transparent" RenderOptions.EdgeMode="Aliased" />
            </Grid>
        </ScrollViewer>

        <TextBlock Grid.Row="1"
                   Text="Click a box to tag who it is. Green = confirmed, orange = suggested (click to confirm or correct), yellow = untagged. Scroll to zoom, middle-drag to pan."
                   Margin="8" Foreground="Gray" />

        <Popup x:Name="PersonPickerPopup" Placement="Right" HorizontalOffset="8" StaysOpen="False" AllowsTransparency="True">
            <Border Background="#FF2D2D30" BorderBrush="Gray" BorderThickness="1" Padding="8" MaxWidth="260">
                <StackPanel>
                    <TextBlock Text="Who is this?" Foreground="White" FontWeight="Bold" Margin="0,0,0,6" />
                    <ListBox x:Name="SuggestionListBox" MaxHeight="200" DisplayMemberPath="DisplayText"
                             MouseUp="SuggestionListBox_MouseUp" />
                    <Separator Margin="0,6,0,6" />
                    <TextBox x:Name="NewPersonNameTextBox" Margin="0,0,0,4"
                             ToolTip="Type a name and press Enter to create a new person (no VRC id)"
                             KeyDown="NewPersonNameTextBox_KeyDown" />
                    <Button Content="Not a face / ignore" Click="IgnoreButton_Click" Margin="0,4,0,0" />
                    <Button x:Name="ClearTagButton" Content="Clear tag" Click="ClearTagButton_Click" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
