bin/
obj/
*.user
.vs/

# Local Velopack pack/release output if `dotnet publish` + `vpk pack` are ever run outside CI
# (.github/workflows/release.yml does both in a throwaway runner, never committing these).
publish/
Releases/

# Transient WPF markup-compile temp project - normally lives under obj/, occasionally leaks
# to the repo root during a build.
*_wpftmp.csproj

# Local app data (db, thumbnails cache) lives in %LocalAppData%\VrcdnManager, not here -
# deliberately still the pre-rename folder name, so existing installs keep their database.

# The WD14 classifier model files are large and not part of this repo - see README.md.
wd14-model/
wd14-index.db

# VrcdnDbContextFactory's design-time fallback db, created by `dotnet ef` tooling commands
# (migrations add/database update) run without an explicit --connection - never the real app
# database, which lives in %LocalAppData%\VrcdnManager instead (see above).
design_time.db

# Subagent-driven-development scratch (ledger, briefs, review packages) - not repo content.
.superpowers/

# Isolated git worktrees created for subagent-driven-development plan execution - not repo
# content, each is its own throwaway checkout on its own branch.
.worktrees/

# Claude Code local configuration and tool state - not repo content.
.claude/

# Serena MCP local configuration and state - not repo content.
.serena/
